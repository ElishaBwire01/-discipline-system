@login_required
def global_recommendations(request):
    try:
        students = Student.objects.filter(is_active=True)
        total_students = students.count()
        critical_count = students.filter(risk_score__gte=60).count()
        warning_count = students.filter(risk_score__range=(30, 59)).count()
        good_count = students.filter(risk_score__lt=30).count()
        total_reports = DisciplineReport.objects.count()
        avg_risk = students.aggregate(Avg('risk_score'))['risk_score__avg'] or 0
        recommendations = []
        critical_students = students.filter(risk_score__gte=60).order_by('-risk_score')[:5]
        if critical_students.count() > 0:
            student_names = ", ".join([s.name for s in critical_students[:3]])
            recommendations.append({
                'action': f'🚨 {critical_students.count()} Critical Risk Students Detected',
                'details': f'Students: {student_names}. Immediate intervention needed.',
                'priority': 'HIGH',
                'steps': ['Schedule parent-teacher meetings immediately', 'Assign school counselor for assessment', 'Implement behavior modification plan']
            })
        warning_students = students.filter(risk_score__range=(30, 59))
        if warning_students.count() > 0:
            recommendations.append({
                'action': f'⚠️ {warning_students.count()} Students at Warning Level',
                'details': 'Monitor these students closely to prevent escalation.',
                'priority': 'MEDIUM',
                'steps': ['Increase monitoring and teacher attention', 'Contact parents for awareness', 'Document all incidents']
            })
        if good_count == total_students and total_students > 0:
            recommendations.append({
                'action': '✅ All Students are Doing Well',
                'details': f'All {total_students} students have low risk scores.',
                'priority': 'LOW',
                'steps': ['Continue positive reinforcement', 'Maintain regular monitoring', 'Celebrate student achievements']
            })
        data = {
            'recommendations': recommendations,
            'global_stats': {
                'total_students': total_students,
                'critical_count': critical_count,
                'warning_count': warning_count,
                'good_count': good_count,
                'total_reports': total_reports,
                'avg_risk': round(avg_risk, 1)
            }
        }
        return JsonResponse(data)
    except Exception as e:
        return JsonResponse({'error': str(e)}, status=500)

@login_required
def student_recommendations(request, student_id):
    try:
        student = get_object_or_404(Student, id=student_id, is_active=True)
        reports = student.reports.select_related('category')
        total_reports = reports.count()
        student_data = {
            'id': student.id,
            'name': student.name,
            'admission_number': student.admission_number,
            'risk_score': student.risk_score,
            'risk_level': student.risk_level,
            'form': student.form,
            'stream': student.stream.name if student.stream else 'N/A',
            'total_reports': total_reports
        }
        recommendations = []
        if student.risk_score >= 60:
            recommendations.append({
                'type': 'critical',
                'title': '🚨 CRITICAL - Immediate Action Required',
                'description': f'{student.name} has reached {student.risk_score}% risk level.'
            })
        elif student.risk_score >= 30:
            recommendations.append({
                'type': 'warning',
                'title': '⚠️ Warning - Monitor Closely',
                'description': f'{student.name} has {student.risk_score}% risk.'
            })
        else:
            recommendations.append({
                'type': 'success',
                'title': '✅ Student Status: Good',
                'description': f'{student.name} is doing well with {student.risk_score}% risk.'
            })
        if total_reports > 0:
            categories = reports.values('category__name').annotate(count=Count('id'))
            for cat in categories:
                if cat['count'] >= 2:
                    recommendations.append({
                        'type': 'pattern',
                        'title': f'📊 Pattern: {cat["category__name"]}',
                        'description': f'{cat["count"]} reports in this category.'
                    })
        data = {
            'student': student_data,
            'recommendations': recommendations,
            'total_reports': total_reports
        }
        return JsonResponse(data)
    except Exception as e:
        return JsonResponse({'error': str(e)}, status=500)

@login_required
def class_recommendations(request, class_id):
    try:
        stream = get_object_or_404(Stream, id=class_id)
        students = Student.objects.filter(stream=stream, is_active=True)
        if students.count() == 0:
            return JsonResponse({
                'stream': stream.name,
                'statistics': {'total_students': 0, 'critical_count': 0, 'warning_count': 0, 'good_count': 0, 'average_risk': 0},
                'recommendations': [{'type': 'INFO', 'action': 'No students in this stream', 'details': 'Add students to this stream to get analysis.'}]
            })
        total = students.count()
        critical = students.filter(risk_score__gte=60).count()
        warning = students.filter(risk_score__range=(30, 59)).count()
        good = students.filter(risk_score__lt=30).count()
        avg_risk = students.aggregate(Avg('risk_score'))['risk_score__avg'] or 0
        top_offenders = students.annotate(report_count=Count('reports')).filter(report_count__gt=0).order_by('-report_count', '-risk_score')[:5]
        top_offenders_data = []
        for s in top_offenders:
            top_offenders_data.append({'name': s.name, 'admission': s.admission_number, 'risk_score': s.risk_score, 'reports': s.report_count})
        recommendations = []
        if critical > 0:
            recommendations.append({'type': 'URGENT', 'action': f'⚠️ {critical} students at critical risk in {stream.name}', 'details': 'Immediate intervention needed.'})
        if warning > 0:
            recommendations.append({'type': 'WARNING', 'action': f'📊 {warning} students at warning level', 'details': 'Monitor these students closely.'})
        if not recommendations:
            recommendations.append({'type': 'SUCCESS', 'action': f'✅ {stream.name} is performing well', 'details': f'All {total} students are doing well.'})
        data = {
            'stream': stream.name,
            'statistics': {'total_students': total, 'critical_count': critical, 'warning_count': warning, 'good_count': good, 'average_risk': round(avg_risk, 1)},
            'top_offenders': top_offenders_data,
            'recommendations': recommendations
        }
        return JsonResponse(data)
    except Exception as e:
        return JsonResponse({'error': str(e)}, status=500)

@login_required
def ai_all_students(request):
    try:
        students = Student.objects.filter(is_active=True).select_related('stream')
        all_students_data = []
        for student in students:
            reports = student.reports.count()
            all_students_data.append({
                'id': student.id,
                'name': student.name,
                'admission': student.admission_number,
                'stream': student.stream.name if student.stream else 'N/A',
                'form': student.form,
                'risk_score': student.risk_score,
                'risk_level': student.risk_level,
                'total_reports': reports,
                'is_critical': student.risk_score >= 60,
            })
        total = len(all_students_data)
        critical = sum(1 for s in all_students_data if s['is_critical'])
        warning = sum(1 for s in all_students_data if 30 <= s['risk_score'] < 60)
        good = sum(1 for s in all_students_data if s['risk_score'] < 30)
        avg_risk = sum(s['risk_score'] for s in all_students_data) / total if total > 0 else 0
        total_reports = DisciplineReport.objects.count()
        insights = []
        if critical > 0:
            critical_students = [s['name'] for s in all_students_data if s['is_critical']][:5]
            insights.append({'type': 'warning', 'title': f'🚨 {critical} Students Need Immediate Attention', 'students': critical_students, 'action': 'Schedule parent meetings and counseling'})
        if warning > 0:
            warning_students = [s['name'] for s in all_students_data if 30 <= s['risk_score'] < 60][:5]
            insights.append({'type': 'info', 'title': f'⚠️ {warning} Students at Warning Level', 'students': warning_students, 'action': 'Increase monitoring and teacher attention'})
        data = {
            'all_students': all_students_data,
            'total_reports': total_reports,
            'stats': {'total': total, 'critical': critical, 'warning': warning, 'good': good, 'avg_risk': round(avg_risk, 1)},
            'insights': insights
        }
        return JsonResponse(data)
    except Exception as e:
        return JsonResponse({'error': str(e)}, status=500)

@login_required
def student_by_name(request):
    try:
        name = request.GET.get('name', '').strip()
        if not name:
            return JsonResponse({'error': 'No name provided'}, status=400)
        student = Student.objects.filter(name__icontains=name, is_active=True).first()
        if not student:
            return JsonResponse({'error': 'Student not found'}, status=404)
        return JsonResponse({
            'id': student.id,
            'name': student.name,
            'admission_number': student.admission_number,
            'stream': student.stream.name if student.stream else 'N/A',
            'form': student.form,
            'risk_score': student.risk_score,
            'risk_level': student.risk_level,
            'total_reports': student.total_reports,
        })
    except Exception as e:
        return JsonResponse({'error': str(e)}, status=500)

# ============================================
# SCHOOL SETUP
# ============================================

@login_required
@user_passes_test(admin_required)
def school_setup(request):
    school, created = School.objects.get_or_create(id=1)
    if request.method == 'POST':
        action = request.POST.get('action')
        if action == 'save_school':
            school.name = request.POST.get('name', 'My School')
            school.short_name = request.POST.get('short_name', '')
            school.motto = request.POST.get('motto', '')
            school.address = request.POST.get('address', '')
            school.phone = request.POST.get('phone', '')
            school.email = request.POST.get('email', '')
            school.website = request.POST.get('website', '')
            school.current_year = int(request.POST.get('current_year', 2026))
            school.terms_per_year = int(request.POST.get('terms_per_year', 3))
            school.allow_teacher_registration = request.POST.get('allow_teacher_registration') == 'on'
            school.require_teacher_approval = request.POST.get('require_teacher_approval') == 'on'
            school.save()
            messages.success(request, '✅ School details saved!')
            return redirect('school_setup')
        elif action == 'add_grade':
            GradeLevel.objects.create(
                school=school,
                name=request.POST.get('grade_name'),
                code=request.POST.get('grade_code'),
                order=int(request.POST.get('grade_order', 0)),
                is_active=True
            )
            messages.success(request, '✅ Grade level added!')
            return redirect('school_setup')
        elif action == 'delete_grade':
            grade = get_object_or_404(GradeLevel, id=request.POST.get('grade_id'))
            grade_name = grade.name
            student_count = Student.objects.filter(grade_level=grade).count()
            if student_count > 0:
                Student.objects.filter(grade_level=grade).update(grade_level=None)
                messages.warning(request, f'⚠️ {student_count} students had "{grade_name}" - Grade removed from their records.')
            grade.delete()
            messages.success(request, f'✅ Grade "{grade_name}" deleted successfully!')
            return redirect('school_setup')
        elif action == 'add_stream':
            stream_name = request.POST.get('stream_name')
            if Stream.objects.filter(school=school, name=stream_name).exists():
                messages.error(request, f'❌ Stream "{stream_name}" already exists!')
            else:
                Stream.objects.create(
                    school=school,
                    name=stream_name,
                    code=request.POST.get('stream_code', stream_name[:3].upper()),
                    is_active=True
                )
                messages.success(request, f'✅ Stream "{stream_name}" added!')
            return redirect('school_setup')
        elif action == 'delete_stream':
            stream = get_object_or_404(Stream, id=request.POST.get('stream_id'))
            stream_name = stream.name
            student_count = Student.objects.filter(stream=stream).count()
            if student_count > 0:
                Student.objects.filter(stream=stream).delete()
                messages.warning(request, f'⚠️ {student_count} students in "{stream_name}" were deleted along with the stream.')
            stream.delete()
            messages.success(request, f'✅ Stream "{stream_name}" and its {student_count} students deleted successfully!')
            return redirect('school_setup')
        elif action == 'add_term':
            term = AcademicTerm.objects.create(
                school=school,
                name=request.POST.get('term_name'),
                term_number=int(request.POST.get('term_number')),
                year=int(request.POST.get('term_year')),
                start_date=request.POST.get('start_date'),
                end_date=request.POST.get('end_date'),
                is_current=request.POST.get('is_current') == 'on'
            )
            if term.is_current:
                AcademicTerm.objects.filter(school=school).exclude(id=term.id).update(is_current=False)
            messages.success(request, '✅ Term added!')
            return redirect('school_setup')
        elif action == 'delete_term':
            term = get_object_or_404(AcademicTerm, id=request.POST.get('term_id'))
            term.delete()
            messages.success(request, '✅ Term deleted!')
            return redirect('school_setup')
    active_grades = GradeLevel.objects.filter(school=school).order_by('order')
    active_streams = Stream.objects.filter(school=school, is_active=True).order_by('name')
    active_terms = AcademicTerm.objects.filter(school=school).order_by('-year', '-term_number')
    context = {
        'school': school,
        'grades': active_grades,
        'streams': active_streams,
        'terms': active_terms,
        'page_title': 'School Setup',
    }
    return render(request, 'school_setup.html', context)

# ============================================
# BULK UPLOAD
# ============================================

@login_required
@user_passes_test(admin_required)
def bulk_upload_students(request):
    if request.method == 'POST' and request.FILES.get('excel_file'):
        try:
            excel_file = request.FILES['excel_file']
            if not excel_file.name.endswith(('.xlsx', '.xls')):
                messages.error(request, 'Please upload a valid Excel file.')
                return redirect('admin_dashboard')
            df = pd.read_excel(excel_file)
            required_columns = ['name', 'admission_number', 'grade', 'stream']
            missing_columns = [col for col in required_columns if col not in df.columns]
            if missing_columns:
                messages.error(request, f'Missing required columns: {", ".join(missing_columns)}')
                return redirect('admin_dashboard')
            added = 0
            errors = []
            school = School.objects.first()
            if not school:
                messages.error(request, 'Please set up your school first.')
                return redirect('school_setup')
            for index, row in df.iterrows():
                try:
                    name = str(row['name']).strip()
                    admission = str(row['admission_number']).strip()
                    grade_name = str(row['grade']).strip()
                    stream_name = str(row['stream']).strip()
                    form = str(row.get('form', '')).strip()
                    year = int(row['year']) if pd.notna(row.get('year')) else 2026
                    notes = str(row.get('notes', '')).strip() if pd.notna(row.get('notes')) else ''
                    grade, _ = GradeLevel.objects.get_or_create(
                        school=school,
                        name=grade_name,
                        defaults={'code': grade_name[:3].upper(), 'order': 0}
                    )
                    stream, _ = Stream.objects.get_or_create(
                        school=school,
                        name=stream_name,
                        defaults={'code': stream_name[:3].upper()}
                    )
                    if not name or not admission:
                        errors.append(f'Row {index + 2}: Missing required data')
                        continue
                    student, created = Student.objects.get_or_create(
                        admission_number=admission,
                        defaults={
                            'name': name,
                            'stream': stream,
                            'grade_level': grade,
                            'form': form or grade_name,
                            'year': year,
                            'optional_notes': notes,
                            'created_by': request.user,
                            'is_active': True
                        }
                    )
                    if created:
                        added += 1
                    else:
                        errors.append(f'Row {index + 2}: Student "{admission}" already exists')
                except Exception as e:
                    errors.append(f'Row {index + 2}: {str(e)}')
            if added > 0:
                messages.success(request, f'✅ Successfully added {added} students!')
            if errors:
                for error in errors[:5]:
                    messages.warning(request, f'⚠️ {error}')
                if len(errors) > 5:
                    messages.warning(request, f'⚠️ And {len(errors) - 5} more errors...')
        except Exception as e:
            messages.error(request, f'Error processing file: {str(e)}')
        return redirect('admin_dashboard')
    return redirect('admin_dashboard')

# ============================================
# USER MANAGEMENT
# ============================================

@login_required
@user_passes_test(admin_required)
def manage_users(request):
    teacher_users = User.objects.filter(
        groups__name__in=['ClassTeacher', 'Teacher']
    ).select_related('teacher_profile').distinct()
    status_filter = request.GET.get('status', '')
    if status_filter == 'pending':
        teacher_users = teacher_users.filter(teacher_profile__is_approved=False, teacher_profile__is_suspended=False)
    elif status_filter == 'approved':
        teacher_users = teacher_users.filter(teacher_profile__is_approved=True, teacher_profile__is_suspended=False)
    elif status_filter == 'suspended':
        teacher_users = teacher_users.filter(teacher_profile__is_suspended=True)
    return render(request, 'manage_users.html', {
        'teacher_users': teacher_users,
        'status_filter': status_filter,
    })

@login_required
@user_passes_test(admin_required)
def approve_user(request, user_id):
    if request.method == 'POST':
        user = get_object_or_404(User, id=user_id)
        profile = get_teacher_profile(user)
        if profile:
            profile.is_approved = True
            profile.approved_at = timezone.now()
            profile.approved_by = request.user
            profile.save()
            notification = Notification.objects.create(
                title='Account Approved',
                message=f'Your account has been approved by {request.user.get_full_name() or request.user.username}.',
                notification_type='info',
            )
            notification.target_users.add(user)
            messages.success(request, f'User {user.username} approved')
    return redirect('manage_users')

@login_required
@user_passes_test(admin_required)
def suspend_user(request, user_id):
    if request.method == 'POST':
        user = get_object_or_404(User, id=user_id)
        reason = request.POST.get('reason', 'No reason provided')
        profile = get_teacher_profile(user)
        if profile:
