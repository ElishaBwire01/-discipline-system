{% extends 'base.html' %}
{% load static %}

{% block title %}Admin Dashboard - {{ school_name|default:"Disciplinary System" }}{% endblock %}

{% block extra_css %}
<style>
    select.form-control-modern,
    select.form-control-modern option,
    select[name="stream"],
    select[name="stream"] option,
    select[name="form"],
    select[name="form"] option,
    .form-control-modern option {
        color: #000000 !important;
        background-color: #ffffff !important;
    }
    
    .form-control-modern {
        color: #000000 !important;
    }
    
    select option {
        color: #000000 !important;
        background-color: #ffffff !important;
        padding: 8px 12px;
    }
    
    select option:hover {
        background-color: #e8f0fe !important;
    }
    
    .text-white option,
    .text-light option {
        color: #000000 !important;
    }
    
    /* Export Section Styles */
    .export-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 0.75rem;
    }
    
    .export-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        background: #f8fafc;
        border-radius: 10px;
        border: 1px solid #e5e7eb;
        transition: all 0.3s ease;
        cursor: pointer;
        text-decoration: none;
        color: #0f172a;
    }
    
    .export-item:hover {
        background: #eff6ff;
        border-color: #2563eb;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.1);
        color: #0f172a;
    }
    
    .export-item .export-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
    }
    
    .export-item .export-icon.excel { background: #d1fae5; color: #059669; }
    .export-item .export-icon.csv { background: #dbeafe; color: #2563eb; }
    .export-item .export-icon.pdf { background: #fef3c7; color: #d97706; }
    .export-item .export-icon.summary { background: #ede9fe; color: #7c3aed; }
    
    .export-item .export-label {
        font-weight: 500;
        font-size: 0.875rem;
    }
    
    .export-item .export-desc {
        font-size: 0.7rem;
        color: #94a3b8;
    }
    
    /* Class Teacher Assignments */
    .assignment-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem 0.75rem;
        background: #f8fafc;
        border-radius: 8px;
        border-left: 3px solid #2563eb;
        margin-bottom: 0.5rem;
        transition: all 0.2s ease;
    }
    
    .assignment-item:hover {
        background: #f1f5f9;
        transform: translateX(4px);
    }
    
    .assignment-item .stream-info {
        font-weight: 600;
        color: #0f172a;
    }
    
    .assignment-item .teacher-info {
        color: #64748b;
        font-size: 0.875rem;
    }
    
    .assignment-item .badge-form {
        background: #eff6ff;
        color: #2563eb;
        padding: 0.125rem 0.5rem;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 600;
    }
</style>
{% endblock %}

{% block content %}
<!-- AI Insights Banner -->
<div class="alert-modern alert alert-info mb-4" data-aos="fade-up" style="background: linear-gradient(135deg, #7c3aed, #2563eb); color: white; border: none;">
    <div class="d-flex justify-content-between align-items-center flex-wrap">
        <div>
            <i class="fas fa-robot fa-2x me-3"></i>
            <strong>AI-Powered Discipline Management</strong>
            <span class="ms-2 badge bg-light text-dark">Active</span>
            <p class="mb-0 mt-1 small opacity-75">Get real-time AI recommendations based on Kenyan Education Act 2013</p>
        </div>
        <a href="{% url 'core:ai_dashboard' %}" class="btn btn-light btn-sm mt-2 mt-md-0">
            <i class="fas fa-robot"></i> Open AI Dashboard
        </a>
    </div>
</div>

<!-- Pending Approvals Alert -->
{% if pending_approvals > 0 %}
<div class="alert-modern alert alert-warning mb-4" data-aos="fade-up">
    <span class="alert-icon"><i class="fas fa-user-clock text-warning"></i></span>
    <div>
        <strong>{{ pending_approvals }}</strong> teacher(s) waiting for approval.
        <a href="{% url 'core:manage_users' %}?status=pending" class="btn btn-sm btn-warning ms-2">Review Now</a>
    </div>
</div>
{% endif %}

<!-- Stats Grid -->
<div class="stat-grid" data-aos="fade-up">
    <div class="stat-card">
        <div class="stat-bg-icon"><i class="fas fa-users"></i></div>
        <div class="stat-icon primary"><i class="fas fa-users"></i></div>
        <div class="stat-value">{{ total_students|default:0 }}</div>
        <div class="stat-label">Total Students</div>
        <div class="stat-change up"><i class="fas fa-arrow-up"></i> Enrolled</div>
    </div>
    <div class="stat-card">
        <div class="stat-bg-icon"><i class="fas fa-exclamation-triangle"></i></div>
        <div class="stat-icon danger"><i class="fas fa-exclamation-triangle"></i></div>
        <div class="stat-value">{{ critical_students|default:0 }}</div>
        <div class="stat-label">Critical Cases</div>
        <div class="stat-change down"><i class="fas fa-arrow-up"></i> Need Intervention</div>
    </div>
    <div class="stat-card">
        <div class="stat-bg-icon"><i class="fas fa-flag"></i></div>
        <div class="stat-icon success"><i class="fas fa-flag"></i></div>
        <div class="stat-value">{{ total_reports|default:0 }}</div>
        <div class="stat-label">Total Reports</div>
        <div class="stat-change up">{{ reports_today|default:0 }} today</div>
    </div>
    <div class="stat-card">
        <div class="stat-bg-icon"><i class="fas fa-user-clock"></i></div>
        <div class="stat-icon info"><i class="fas fa-user-clock"></i></div>
        <div class="stat-value">{{ online_count|default:0 }}</div>
        <div class="stat-label">Online Teachers</div>
        <div class="stat-change up"><i class="fas fa-circle" style="color: #10b981; font-size: 8px;"></i> Active</div>
    </div>
</div>

<!-- Quick Actions -->
<div class="card-modern mb-4" data-aos="fade-up">
    <div class="card-header-modern">
        <span class="header-icon"><i class="fas fa-cog"></i></span>
        System Management
    </div>
    <div class="card-body p-3">
        <div class="d-flex flex-wrap gap-2">
            <a href="{% url 'core:manage_users' %}" class="btn-modern btn-modern-primary">
                <i class="fas fa-users"></i> Manage Users
                {% if pending_approvals > 0 %}<span class="badge bg-light text-dark ms-1">{{ pending_approvals }}</span>{% endif %}
            </a>
            <a href="{% url 'core:admin_reset_requests' %}" class="btn-modern btn-modern-warning">
                <i class="fas fa-key"></i> Password Resets
                <span class="badge bg-light text-dark ms-1" id="resetCount">{{ pending_resets|default:0 }}</span>
            </a>
            <a href="{% url 'core:school_setup' %}" class="btn-modern" style="background: linear-gradient(135deg, #059669, #10b981); color: white;">
                <i class="fas fa-school"></i> School Setup
            </a>
            <a href="{% url 'core:ai_dashboard' %}" class="btn-modern" style="background: linear-gradient(135deg, #7c3aed, #2563eb); color: white;">
                <i class="fas fa-robot"></i> AI Analysis
            </a>
            <a href="{% url 'core:user_profile_settings' %}" class="btn-modern btn-modern-secondary">
                <i class="fas fa-user-cog"></i> My Profile
            </a>
        </div>
    </div>
</div>

<!-- Export Reports -->
<div class="card-modern mb-4" data-aos="fade-up">
    <div class="card-header-modern" style="background: linear-gradient(135deg, #059669, #10b981);">
        <span class="header-icon"><i class="fas fa-file-export"></i></span>
        Export Reports
        <span class="ms-auto badge bg-light text-dark">Admin Only</span>
    </div>
    <div class="card-body p-3">
        <div class="export-grid">
            <a href="{% url 'core:export_reports' 'csv' %}" class="export-item">
                <span class="export-icon csv"><i class="fas fa-file-csv"></i></span>
                <div>
                    <div class="export-label">All Reports (CSV)</div>
                    <div class="export-desc">School-wide reports</div>
                </div>
            </a>
            <a href="{% url 'core:export_reports' 'excel' %}" class="export-item">
                <span class="export-icon excel"><i class="fas fa-file-excel"></i></span>
                <div>
                    <div class="export-label">All Reports (Excel)</div>
                    <div class="export-desc">School-wide reports</div>
                </div>
            </a>
            <a href="{% url 'core:export_summary_report' %}" class="export-item">
                <span class="export-icon summary"><i class="fas fa-file-alt"></i></span>
                <div>
                    <div class="export-label">Summary Report</div>
                    <div class="export-desc">Statistics & overview</div>
                </div>
            </a>
            <a href="{% url 'core:export_pdf_report' %}" class="export-item">
                <span class="export-icon pdf"><i class="fas fa-file-pdf"></i></span>
                <div>
                    <div class="export-label">PDF Report</div>
                    <div class="export-desc">Printable version</div>
                </div>
            </a>
        </div>
    </div>
</div>

<!-- Add Student Section -->
<div class="card-modern mb-4" data-aos="fade-up">
    <div class="card-header-modern">
        <span class="header-icon"><i class="fas fa-plus-circle"></i></span>
        Add Student
        <a href="{% url 'core:add_student' %}" class="btn btn-sm btn-outline-light float-end">
            <i class="fas fa-external-link-alt"></i> Advanced Form
        </a>
    </div>
    <div class="card-body p-4">
        <form method="post" action="{% url 'core:admin_dashboard' %}">
            {% csrf_token %}
            <input type="hidden" name="action" value="add_student">
            <div class="row g-3">
                <div class="col-md-3">
                    <input type="text" name="admission_number" class="form-control-modern" placeholder="Admission Number" required>
                </div>
                <div class="col-md-3">
                    <input type="text" name="name" class="form-control-modern" placeholder="Full Name" required>
                </div>
                <div class="col-md-2">
                    <select name="stream" class="form-control-modern" required>
                        <option value="">-- Select Stream --</option>
                        {% for stream in streams %}
                        <option value="{{ stream.id }}">{{ stream.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="grade_level" class="form-control-modern">
                        <option value="">-- Select Grade --</option>
                        {% for grade in grade_levels %}
                        <option value="{{ grade.id }}">{{ grade.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="form" class="form-control-modern" required>
                        <option value="">-- Select Form --</option>
                        {% for form_key, form_name in forms %}
                        <option value="{{ form_key }}">{{ form_name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-12">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="fas fa-save me-1"></i>Add Student
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

        </form>
    </div>
</div>

        </form>
    </div>
</div>

<!-- Risk Distribution -->
<div class="card-modern mb-4" data-aos="fade-up">
    <div class="card-header-modern">
        <span class="header-icon"><i class="fas fa-chart-bar"></i></span>
        Risk Distribution
        <span class="ms-auto badge bg-light text-dark">Overall Status</span>
    </div>
    <div class="card-body p-3">
        <div class="row text-center">
            <div class="col-4">
                <span class="text-danger fw-bold">{{ critical_percentage|default:"0" }}%</span>
                <div class="text-muted small">Critical</div>
            </div>
            <div class="col-4">
                <span class="text-warning fw-bold">{{ warning_percentage|default:"0" }}%</span>
                <div class="text-muted small">Warning</div>
            </div>
            <div class="col-4">
                <span class="text-success fw-bold">{{ good_percentage|default:"0" }}%</span>
                <div class="text-muted small">Good</div>
            </div>
        </div>
        <div class="progress-modern mt-2" style="height: 8px;">
            <div class="progress-bar bg-danger" style="width: {{ critical_percentage|default:0 }}%;"></div>
            <div class="progress-bar bg-warning" style="width: {{ warning_percentage|default:0 }}%;"></div>
            <div class="progress-bar bg-success" style="width: {{ good_percentage|default:0 }}%;"></div>
        </div>
    </div>
</div>

<!-- Class Teacher Assignments -->
{% if class_teacher_assignments %}
<div class="card-modern mb-4" data-aos="fade-up">
    <div class="card-header-modern" style="background: linear-gradient(135deg, #7c3aed, #2563eb);">
        <span class="header-icon"><i class="fas fa-chalkboard-teacher"></i></span>
        Class Teacher Assignments
        <span class="ms-auto badge bg-light text-dark">{{ class_teacher_assignments|length }}</span>
    </div>
    <div class="card-body p-3">
        <div class="row">
            {% for assignment in class_teacher_assignments %}
            <div class="col-md-4 col-sm-6">
                <div class="assignment-item">
                    <div>
                        <div class="stream-info">{{ assignment.assigned_stream.name }}</div>
                        <div class="teacher-info">
                            <i class="fas fa-user me-1"></i>
                            {{ assignment.user.get_full_name|default:assignment.user.username }}
                        </div>
                    </div>
                    <span class="badge-form">{{ assignment.assigned_form }}</span>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endif %}

<!-- Students Table -->
<div class="card-modern" data-aos="fade-up">
    <div class="card-header-modern">
        <span class="header-icon"><i class="fas fa-search"></i></span>
        Students
        <span class="badge bg-light text-dark ms-2">{{ students.paginator.count }}</span>
    </div>
    <div class="card-body p-3">
        <form method="get" class="row g-2 mb-3">
            <div class="col-md-3">
                <input type="text" name="search" class="form-control-modern" placeholder="Search..." value="{{ search_query }}">
            </div>
            <div class="col-md-2">
                <select name="stream" class="form-control-modern">
                <div class="col-md-2">
                    <select name="grade_level" class="form-control-modern">
                        <option value="">-- Select Grade --</option>
                        {% for grade in grade_levels %}
                        <option value="{{ grade.id }}">{{ grade.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                    <option value="">All Streams</option>
                    {% for stream in streams %}
                    <option value="{{ stream.name }}" {% if stream_filter == stream.name %}selected{% endif %}>{{ stream.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <select name="form" class="form-control-modern">
                    <option value="">All Forms</option>
                    {% for form_key, form_name in forms %}<option value="{{ form_key }}">{{ form_name }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <select name="risk" class="form-control-modern">
                    <option value="">All Status</option>
                    <option value="critical" {% if risk_filter == 'critical' %}selected{% endif %}>Critical</option>
                    <option value="warning" {% if risk_filter == 'warning' %}selected{% endif %}>Warning</option>
                    <option value="good" {% if risk_filter == 'good' %}selected{% endif %}>Good</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn-modern btn-modern-primary w-100"><i class="fas fa-filter"></i> Filter</button>
            </div>
        </form>
        
        <div class="table-responsive">
            <table class="table-modern">
                <thead>
                    <tr>
                        <th>Admission</th>
                        <th>Name</th>
                        <th>Stream</th>
                        <th>Form</th>
                        <th>Reports</th>
                        <th>Risk Score</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for student in students %}
                    <tr>
                        <td><strong>{{ student.admission_number }}</strong></td>
                        <td>{{ student.name }}</td>
                        <td><span class="badge-modern badge-info">{{ student.stream.name|default:"-" }}</span></td>
                        <td>{{ student.form|default:"-" }}</td>
                        <td>
                            <span class="badge-modern {% if student.total_reports >= 20 %}badge-critical{% elif student.total_reports >= 10 %}badge-warning{% else %}badge-info{% endif %}">
                                {{ student.total_reports }}
                            </span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress-modern" style="width: 80px;">
                                    <div class="progress-bar-modern" style="width: {{ student.risk_score }}%; background: {% if student.risk_score >= 60 %}linear-gradient(135deg, #ef4444, #dc2626){% elif student.risk_score >= 30 %}linear-gradient(135deg, #f59e0b, #d97706){% else %}linear-gradient(135deg, #10b981, #059669){% endif %};"></div>
                                </div>
                                <span class="fw-bold" style="font-size:0.813rem;">{{ student.risk_score }}%</span>
                            </div>
                        </td>
                        <td>
                            {% if student.is_critical %}
                            <span class="badge-modern badge-critical"><i class="fas fa-exclamation-circle"></i> Critical</span>
                            {% elif student.risk_score >= 30 %}
                            <span class="badge-modern badge-warning"><i class="fas fa-exclamation-triangle"></i> Warning</span>
                            {% else %}
                            <span class="badge-modern badge-success"><i class="fas fa-check-circle"></i> Good</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a href="{% url 'core:student_profile' student.id %}" class="btn-modern btn-modern-primary btn-modern-sm" title="View Profile">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{% url 'core:student_profile' student.id %}?ai=true" class="btn-modern btn-modern-sm" style="background: linear-gradient(135deg, #7c3aed, #2563eb); color: white;" title="AI Analysis">
                                    <i class="fas fa-robot"></i>
                                </a>
                                <button class="btn-modern btn-modern-danger btn-modern-sm" onclick="openReportModal({{ student.id }}, '{{ student.name }}')" title="Report">
                                    <i class="fas fa-flag"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="fas fa-inbox fa-2x d-block mb-2"></i>
                            No students found. Start by adding your first student!
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        
        <!-- Pagination with per_page support -->
        {% include 'includes/pagination.html' with page_obj=students per_page=per_page %}
    </div>
</div>

<!-- Report Modal -->
<div class="modal fade" id="reportModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0" style="background: linear-gradient(135deg, #ef4444, #dc2626); color: white; border-radius: 16px 16px 0 0;">
                <h5 class="modal-title fw-bold"><i class="fas fa-flag me-2"></i>Report Student</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="{% url 'core:admin_dashboard' %}" id="reportForm">
                {% csrf_token %}
                <input type="hidden" name="action" value="report_student">
                <input type="hidden" name="student_id" id="reportStudentId" value="0">
                <div class="modal-body p-4">
                    <p class="mb-3">Reporting: <strong id="reportStudentName" style="color: #2563eb;"></strong></p>
                    {% include 'includes/custom_case.html' with categories=categories %}
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn-modern btn-modern-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-modern" style="background: linear-gradient(135deg, #ef4444, #dc2626); color: white;" id="submitReportBtn">
                        <i class="fas fa-paper-plane"></i> Submit Report
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function openReportModal(id, name) {
    document.getElementById('reportStudentId').value = id;
    document.getElementById('reportStudentName').textContent = name;
    new bootstrap.Modal(document.getElementById('reportModal')).show();
}

// Auto-refresh stats every 30 seconds
setInterval(function() {
    fetch('/api/admin-notifications/')
        .then(r => r.json())
        .then(data => {
            if (data.total !== undefined) {
                const badge = document.querySelector('.notification-badge');
                if (badge) badge.textContent = data.total || 0;
            }
        });
}, 30000);

// Keyboard shortcuts for pagination (Ctrl+Home/End)
document.addEventListener('keydown', function(e) {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    
    // Ctrl+Home for first page
    if (e.ctrlKey && e.key === 'Home') {
        e.preventDefault();
        window.location.href = '?page=1';
    }
    
    // Ctrl+End for last page
    if (e.ctrlKey && e.key === 'End') {
        e.preventDefault();
        window.location.href = '?page={{ students.paginator.num_pages }}';
    }
});
</script>
{% endblock %}
